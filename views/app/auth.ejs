<%- include('../partials/head') %>
<h1 class="text-3xl font-bold tracking-tight">Log in / Sign up</h1>
<p class="mt-4 max-w-2xl text-slate-600">Placeholder shell. Authentication is not implemented yet.</p>

<div class="mt-8 grid gap-6 md:grid-cols-2">
  <form class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-semibold">Log in</h2>
    <label class="mt-4 block text-sm font-medium" for="login-email">Email</label>
    <input id="login-email" type="email" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
    <label class="mt-4 block text-sm font-medium" for="login-password">Password</label>
    <input id="login-password" type="password" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
    <button type="button" disabled class="mt-6 w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white opacity-50">Log in</button>
  </form>

  <form class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-semibold">Sign up</h2>
    <label class="mt-4 block text-sm font-medium" for="signup-name">Name</label>
    <input id="signup-name" type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
    <label class="mt-4 block text-sm font-medium" for="signup-email">Email</label>
    <input id="signup-email" type="email" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
    <label class="mt-4 block text-sm font-medium" for="signup-password">Password</label>
    <input id="signup-password" type="password" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
    <button type="button" disabled class="mt-6 w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white opacity-50">Create account</button>
  </form>
</div>
<%- include('../partials/foot') %>
